{
  "name": "pip",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "APP_MODE=local next dev",
    "dev:cloud": "APP_MODE=cloud next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run --project unit",
    "test:int": "VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run --project int",
    "test:e2e": "rm -rf .data/e2e .data/e2e-blobs && next build && playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:int",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed-local.ts",
    "icons": "tsx scripts/gen-icons.ts",
    "vapid": "tsx scripts/gen-vapid.ts",
    "doctor": "tsx scripts/doctor.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.124.0",
    "@electric-sql/pglite": "0.5.8",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/fredoka": "5.3.0",
    "@fontsource-variable/nunito-sans": "5.3.0",
    "@supabase/ssr": "0.12.6",
    "@supabase/supabase-js": "2.115.0",
    "drizzle-orm": "0.45.2",
    "jszip": "3.10.1",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "0.35.4",
    "stripe": "22.6.1",
    "web-push": "3.6.7",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
