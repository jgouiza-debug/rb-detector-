# ─────────────────────────────────────────────────────────────────────────────
# Pip environment. Copy to .env.local for cloud mode. Local mode needs NOTHING.
# ─────────────────────────────────────────────────────────────────────────────

# local | cloud. Defaults to local when VERCEL_ENV is unset. Refused as local when
# VERCEL_ENV=production. Every *_PROVIDER below defaults from this and can be
# overridden individually (e.g. cloud DB with scripted AI for a demo).
APP_MODE=local

# Public URL of the deployed app (Stripe success/cancel URLs, push deep links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────────────────────────
# DB_PROVIDER=pglite|postgres
# Cloud: Supabase transaction pooler URL (port 6543). Migrate with `pnpm db:migrate`.
DATABASE_URL=
# Local: directory for the embedded Postgres (pglite). `memory://` for tests.
PGLITE_DATA_DIR=.data/pglite

# ── Auth (Supabase) ─────────────────────────────────────────────────────────
# AUTH_PROVIDER=local|supabase. Enable "Allow anonymous sign-ins" in Supabase Auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local only: HMAC secret for the dev session cookie (has a built-in default).
LOCAL_AUTH_SECRET=

# ── Photo storage ───────────────────────────────────────────────────────────
# BLOB_PROVIDER=fs|supabase. Create a PRIVATE bucket named `media` in Supabase.
SUPABASE_STORAGE_BUCKET=media
BLOB_DIR=.data/blobs

# ── AI (Anthropic) ──────────────────────────────────────────────────────────
# AI_PROVIDER=scripted|anthropic
ANTHROPIC_API_KEY=
PIP_MODEL=claude-sonnet-5

# ── Voice transcription (optional, BYO key) ─────────────────────────────────
# Default dictation is on-device (Web Speech) and needs nothing here. Users who
# bring their own key get an OpenAI-compatible server path. TRANSCRIPTION_PROVIDER
# =scripted|openai. Each user's key is stored server-side (never in env).
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=whisper-1

# ── Billing (Stripe) ────────────────────────────────────────────────────────
# BILLING_PROVIDER=mock|stripe. Test keys on Preview, live keys on Production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Shown in the UI when the live price cannot be fetched (and always in local mode).
NEXT_PUBLIC_PLUS_PRICE_LABEL=$4.99/mo

# ── Push (web-push / VAPID) ─────────────────────────────────────────────────
# PUSH_PROVIDER=outbox|webpush. Generate keys with `pnpm vapid`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Scheduler ───────────────────────────────────────────────────────────────
# Bearer token for GET /api/cron/tick (GitHub Actions secret CRON_SECRET).
CRON_SECRET=

# ── Cost caps ───────────────────────────────────────────────────────────────
DAILY_REPLY_CAP_FREE=150
DAILY_REPLY_CAP_PLUS=400
DAILY_CAPTION_CAP=40
DAILY_SYNTHESIS_CAP=3
GLOBAL_DAILY_REPLY_CAP=3000

# ── Dev / test only ─────────────────────────────────────────────────────────
# PIP_FAKE_NOW=2026-09-06T21:05:00Z   (local mode: freeze the clock)
# PIP_SCRIPTED_RISK_FAIL=1            (local mode: make the risk classifier throw)
# NEXT_PUBLIC_SW=1                    (register the service worker in dev)
